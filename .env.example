# Copy to .env.local and fill in. Never put real keys in this file (it is committed to git).
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — console.anthropic.com → API Keys. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Admin pages (/admin). Server only — never prefix with NEXT_PUBLIC_.
# Supabase Dashboard → Project Settings → API → service_role key (bypasses RLS: keep it secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Comma-separated emails that may open /admin (the email must be confirmed).
ADMIN_EMAILS=you@example.com
